# ==========================================
# GMRIT CSE TEACHERS' DAY 2026 - ENVIRONMENT
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# ------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY INTEGRATION
# ------------------------------------------
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# For Testing: Use "Test Mode" keys (starts with rzp_test_...)
# For Live Payments: Switch to "Live Mode" and use live keys (starts with rzp_live_...)

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ------------------------------------------
# Secret PIN for CSE Committee Dashboard
ADMIN_PIN=YOUR_SECURE_ADMIN_PIN_HERE

# ------------------------------------------
# 3. OPTIONAL CLOUD DATABASE CONFIGURATION
# ------------------------------------------
# By default, the application runs on the zero-config local JSON database (server/data.json).
# If you want to connect MongoDB Atlas or PostgreSQL, provide your URI below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/teachersday2026?retryWrites=true&w=majority
